{
  "name": "travelkeeper",
  "private": true,
  "scripts": {
    "staging:migration-check": "node scripts/staging-migration-check.mjs",
    "staging:attribution-gate": "node scripts/attribution-staging-gate.mjs",
    "staging:attribution-baseline": "node scripts/attribution-staging-gate.mjs --baseline",
    "staging:attribution-pending": "node scripts/attribution-staging-gate.mjs --pending",
    "staging:attribution-smoke": "node scripts/attribution-staging-gate.mjs --remote",
    "staging:attribution-baseline:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/attribution-staging-gate.ps1 -Mode Baseline",
    "staging:attribution-pending:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/attribution-staging-gate.ps1 -Mode Pending",
    "staging:attribution-smoke:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/attribution-staging-gate.ps1 -Mode Smoke",
    "test": "node --test tests/*.test.mjs",
    "migration:plan": "node scripts/d1-remote-migration-plan.mjs",
    "schema:equivalence": "node scripts/d1-schema-equivalence.mjs",
    "bootstrap:generate": "node scripts/d1-bootstrap-generator.mjs --write",
    "bootstrap:check": "node scripts/d1-bootstrap-generator.mjs --check"
  }
}
